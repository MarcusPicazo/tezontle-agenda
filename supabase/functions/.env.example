# Secretos de la Edge Function. Súbalos con:
#   npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY ya los pone Supabase automáticamente.)

# A quién le llega cada reserva (además del candidato).
MARCUS_EMAIL=tezontle3d@outlook.com

# Google Calendar + Meet (ver README, paso 3).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Dominios que pueden reservar, separados por coma (vacío = cualquiera).
ALLOWED_ORIGINS=https://agenda.tezontle3d.com,http://localhost:4321

# Opcional: correo extra con la marca de Tezontle vía Resend (resend.com).
RESEND_API_KEY=
EMAIL_FROM=Tezontle 3D <agenda@tezontle3d.com>
